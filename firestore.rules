rules_version = '2';
// Security rules: the server checks these on EVERY read and write.
// They are what stops someone from reading chats that aren't theirs,
// even if they change the app's code. The app can be hacked; these can't.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // users/<uid>: anyone logged in can see profiles (to find friends),
    // but you can only create or change YOUR OWN profile,
    // and the phone number must be the one you really logged in with.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;

      // users/<uid>/blocked/<their uid>: only you can see or change who you blocked.
      match /blocked/{blockedId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // reports/<id>: anyone can send a report as themselves. Nobody can read them
    // from the app: you read them in the Firebase console.
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
    }

    match /chats/{chatId} {
      // Direct chat ids are "uidA_uidB", so the id itself says who is in it.
      function ids() {
        return chatId.split('_');
      }
      function isDirectId() {
        return ids().size() == 2;
      }
      function inId() {
        return isDirectId() && request.auth.uid in ids();
      }
      function chatPath() {
        return /databases/$(database)/documents/chats/$(chatId);
      }
      // In the chat before this write (get) or after it (getAfter).
      // "After" matters when a new chat and its first message are saved together.
      function memberBefore() {
        return exists(chatPath()) && request.auth.uid in get(chatPath()).data.members;
      }
      function memberAfter() {
        return existsAfter(chatPath()) && request.auth.uid in getAfter(chatPath()).data.members;
      }
      function canRead() {
        return signedIn() && (inId() || memberBefore());
      }
      // The other person in a direct chat
      function otherId() {
        return ids()[0] == request.auth.uid ? ids()[1] : ids()[0];
      }
      // Did the other person block me?
      function blockedByOther() {
        return isDirectId() && exists(/databases/$(database)/documents/users/$(otherId())/blocked/$(request.auth.uid));
      }
      function canPost() {
        return signedIn() && (inId() || memberBefore() || memberAfter()) && !blockedByOther();
      }
      // My name, from my profile. Messages must carry my real name, so nobody can pretend to be someone else.
      function myName() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
      }
      // The "last message" in the chat list must be mine, with my real name.
      function lastMessageIsMine() {
        return request.resource.data.lastMessage.senderId == request.auth.uid
          && request.resource.data.lastMessage.senderName == myName();
      }
      function lastMessageOk() {
        return request.resource.data.get('lastMessage', null) == resource.data.get('lastMessage', null)
          || lastMessageIsMine();
      }
      // You can only change your own name in the chat, plus the names of people the admin adds.
      function namesOk() {
        let changed = request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys();
        let added = request.resource.data.members.removeAll(resource.data.members);
        return changed.hasOnly(added.concat([request.auth.uid]));
      }

      // ----- the chat document -----
      allow get: if signedIn() && (inId() || request.auth.uid in resource.data.members);
      // Listing ("show me my chats") only works if the query asks for chats you're in.
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn() && lastMessageIsMine() && (
        // A direct chat: you must be one of the two, and nobody else can be in it.
        (inId()
          && request.resource.data.members == ids()
          && request.resource.data.get('type', 'direct') == 'direct')
        ||
        // A group: you're the admin, you're in it, it has a name and 2 to 50 people.
        (!isDirectId()
          && request.resource.data.type == 'group'
          && request.resource.data.admin == request.auth.uid
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() >= 2
          && request.resource.data.members.size() <= 50
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 50)
      );

      allow update: if signedIn()
        && (inId() || request.auth.uid in resource.data.members)
        && lastMessageOk()
        && namesOk()
        // a direct chat can't turn into a group, or the other way round
        && request.resource.data.get('type', 'direct') == resource.data.get('type', 'direct')
        && (
          // Normal updates (new message, ticks, typing): nobody joins or leaves.
          (request.resource.data.members == resource.data.members
            && request.resource.data.get('admin', '') == resource.data.get('admin', ''))
          ||
          // The group admin adds people (up to 50).
          (resource.data.get('type', 'direct') == 'group'
            && request.auth.uid == resource.data.admin
            && request.resource.data.admin == resource.data.admin
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() > resource.data.members.size()
            && request.resource.data.members.size() <= 50)
          ||
          // Anyone leaves a group: only they disappear. An admin who leaves
          // hands "admin" to someone still in the group.
          (resource.data.get('type', 'direct') == 'group'
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && (request.resource.data.admin == resource.data.admin
              || (request.auth.uid == resource.data.admin
                && request.resource.data.admin in request.resource.data.members)))
        );

      // ----- messages -----
      match /messages/{messageId} {
        allow read: if canRead();
        // Send only as yourself, with the server's time, and a real message.
        // Nobody can edit or delete messages (yet).
        allow create: if canPost()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == myName()
          && request.resource.data.sentAt == request.time
          && validMessage(request.resource.data);
      }

      function validMessage(m) {
        return (m.kind == 'text' && m.text is string && m.text.size() > 0 && m.text.size() <= 2000)
          || (m.kind in ['photo', 'voice'] && m.mediaId is string)
          || (m.kind == 'system' && m.event in ['created', 'added', 'left']);
      }

      // ----- photos and voice notes (see media.ts) -----
      match /media/{mediaId} {
        allow read: if canRead();
        allow create: if canPost()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.data is string;
      }
    }
  }
}
