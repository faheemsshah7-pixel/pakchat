<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Calls: the mic and camera, ringing over a locked screen, and keeping a call going in the background. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <!-- Phase 7: scheduled messages wake PakChat at their time, also after a restart (Scheduled.kt). -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Live location keeps going after you leave PakChat, with its alert showing (LiveLocation.kt). -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- The phone makers' "Autostart" settings pages, so PakChat may open them (see Autostart.kt). -->
  <queries>
    <package android:name="com.miui.securitycenter" />
    <package android:name="com.coloros.safecenter" />
    <package android:name="com.oppo.safe" />
    <package android:name="com.iqoo.secure" />
    <package android:name="com.vivo.permissionmanager" />
    <package android:name="com.huawei.systemmanager" />
    <package android:name="com.hihonor.systemmanager" />
  </queries>
  <application>
    <!-- Reply, Mark as read and Mute on a message alert (see ChatAlerts.kt). -->
    <receiver android:name="expo.modules.pakchatsignal.AlertActionReceiver" android:exported="false" />
    <service android:name="expo.modules.pakchatsignal.AlertActionService" android:exported="false" />
    <!-- Decline and Hang up on a call alert, and the ongoing call (see CallService.kt). -->
    <receiver android:name="expo.modules.pakchatsignal.CallActionReceiver" android:exported="false" />
    <service android:name="expo.modules.pakchatsignal.CallActionService" android:exported="false" />
    <!-- The incoming call screen on a locked phone (see IncomingCallActivity.kt). -->
    <activity
        android:name="expo.modules.pakchatsignal.IncomingCallActivity"
        android:exported="false"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:launchMode="singleTop"
        android:taskAffinity="com.pakchat.app.incomingcall"
        android:excludeFromRecents="true"
        android:screenOrientation="portrait"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    <service android:name="expo.modules.pakchatsignal.CallService" android:exported="false" android:foregroundServiceType="microphone|camera" />
    <!-- Scheduled messages (Scheduled.kt). -->
    <receiver android:name="expo.modules.pakchatsignal.ScheduledReceiver" android:exported="false" />
    <service android:name="expo.modules.pakchatsignal.ScheduledService" android:exported="false" />
    <receiver android:name="expo.modules.pakchatsignal.ScheduledBootReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>
    <!-- Live location (LiveLocation.kt). -->
    <service android:name="expo.modules.pakchatsignal.LiveLocationService" android:exported="false" android:foregroundServiceType="location" />
    <receiver android:name="expo.modules.pakchatsignal.LiveStopReceiver" android:exported="false" />
  </application>
</manifest>
