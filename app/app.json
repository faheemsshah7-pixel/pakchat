{
  "expo": {
    "name": "PakChat",
    "slug": "pakchat",
    "version": "1.0.24",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pakchat.app"
    },
    "android": {
      "versionCode": 24,
      "adaptiveIcon": {
        "backgroundColor": "#2F6BF0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pakchat.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSignal",
      "./plugins/withScreenSlide",
      "./plugins/withCallPip",
      "./plugins/withCropDone",
      "./plugins/withScreenShare",
      "./plugins/withNativeKeeps",
      "./plugins/withReleaseKey",
      "./plugins/withFastScreen",
      "./plugins/withSplashBars",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark-light.png",
          "imageWidth": 90,
          "backgroundColor": "#F1F2F4",
          "dark": {
            "image": "./assets/splash-mark-dark.png",
            "backgroundColor": "#111214"
          }
        }
      ],
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "NotoNastaliqUrdu",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/noto-nastaliq-urdu/400Regular/NotoNastaliqUrdu_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/noto-nastaliq-urdu/700Bold/NotoNastaliqUrdu_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "PakIcons16",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/icons/PakIcons16.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "PakIcons19",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/icons/PakIcons19.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "PakIcons22",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/icons/PakIcons22.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "PakIcons24",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/icons/PakIcons24.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "PakIcons26",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/icons/PakIcons26.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "PakIcons30",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/icons/PakIcons30.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "# PakChat: what R8 (code shrinking) must never remove or rename.\n# Code reached from native C++/Rust by name (JNI), which R8 can't see.\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.margelo.nitro.** { *; }\n-keep class org.webrtc.** { *; }\n-keep class com.oney.WebRTCModule.** { *; }\n-keep class org.signal.libsignal.** { *; }\n-keep class org.rustls.platformverifier.** { *; }\n# Our own native module and app classes (encryption, alerts, calls, services).\n-keep class expo.modules.pakchatsignal.** { *; }\n-keep class com.pakchat.app.** { *; }\n# Readable crash reports: keep file names and line numbers.\n-keepattributes SourceFile,LineNumberTable"
          }
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "PakChat uses the microphone for voice notes and calls."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "PakChat uses your contacts to show which friends are on PakChat, and to save new contacts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PakChat lets you send photos and videos.",
          "cameraPermission": "PakChat lets you take photos and videos to send."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F6BF0",
          "defaultChannel": "messages"
        }
      ],
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "PakChat lets you take photos, videos and round videos to send.",
          "microphonePermission": "PakChat records sound with your videos and round videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PakChat sends your location only when you choose to share it.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo",
            "video"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "459861530466-6clhf90r8bfd2urbikjsqicvkcndbel9.apps.googleusercontent.com",
      "serverUrl": "https://pakchat.duckdns.org"
    },
    "scheme": "pakchat",
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": false
    },
    "backgroundColor": "#EAF2FE"
  }
}
