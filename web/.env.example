# Settings that stay on your own computer. To use one, make a copy of this file
# called .env.local (in this same "web" folder) and fill it in there.
# (git ignores .env.local, so it's never pushed. Build again after changing it.)

# A relay for calls, for networks where two browsers can't reach each other directly
# (see LEARN.md, Step 21). The address from your relay's dashboard that gives out its
# servers and passwords, for example Metered's "credentials" address:
#   VITE_TURN_CREDENTIALS_URL=https://yourapp.metered.live/api/v1/turn/credentials?apiKey=...
VITE_TURN_CREDENTIALS_URL=

# GIFs (see LEARN.md, Step 21): PakChat's key from KLIPY's Partner Panel (partner.klipy.com).
# Without one, the GIF tab isn't shown.
#   VITE_KLIPY_KEY=...
VITE_KLIPY_KEY=
