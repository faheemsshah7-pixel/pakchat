# Copy this file to .env (git ignores .env) and fill it in.
# PakChat's Google client ids, comma separated, from Google Cloud > APIs & Services > Credentials.
GOOGLE_CLIENT_IDS=

# How sign-in codes are sent. "terminal" prints them in this window (free, for testing).
# "twilio" sends real SMS: also fill in the three TWILIO_ lines (from twilio.com > Verify).
SMS=terminal
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=
# The most codes the whole server sends in a day (each real SMS costs money).
SMS_DAILY_CAP=100

# The biggest file people can send, in MB. The app asks the server, so no app update is needed.
FILE_MAX_MB=100

# Push alerts: the full path to Firebase's service account key file (keep it outside the repo).
# FCM_SERVICE_ACCOUNT=/Users/you/pakchat-secrets/firebase-service-account.json
