# Caddyfile: PakChat's front door. Caddy gets the HTTPS certificate by itself.
{
	# HTTP/1.1 and HTTP/2 only, no HTTP/3 (QUIC). On 1 Nov the APK downloaded by Chrome on
	# phones in Pakistan arrived the right size but wouldn't install, while the same file
	# fetched over HTTP/2 was byte-for-byte right; HTTP/3 was the one difference left.
	servers {
		protocols h1 h2
	}
}
# The server: the app's and website's API, live connections, and the invite and
# call-link pages (with their own small styles and pictures).
(server) {
	encode zstd gzip
	# Browsers always use the secure address for a year, even when someone types http://.
	header Strict-Transport-Security "max-age=31536000"
	@server path /api/* /socket/* /link/* /live/* /join/* /calllink/* /assets/default.css /assets/css/* /assets/js/* /images/*
	handle @server {
		reverse_proxy app:4000
	}
}

# The APK and what its newest version is, which apps check for updates.
(apk) {
	# Must always be fresh.
	header /pakchat-apk.json Cache-Control "no-store"
	header /pakchat.apk Content-Type "application/vnd.android.package-archive"
	# Never an older copy from the phone's own browser (which can't install over a newer
	# PakChat: "Can't install app"), and always saved as a file.
	header /pakchat.apk Cache-Control "no-store"
	header /pakchat.apk Content-Disposition `attachment; filename="PakChat.apk"`
}

{$PAKCHAT_DOMAIN} {
	import server

	# Everything else is the website (and the APK).
	handle {
		root * /srv/site
		# Built files have a fingerprint in their name, so they're kept for a year.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# These must always be fresh: the page itself and its helper.
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		import apk
		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "same-origin"
			X-Frame-Options "DENY"
			# Only the website's own files may run here (plus WebAssembly, for the encryption), so
			# code slipped in from elsewhere can't. Google Fonts is only for the Urdu font. Tested
			# against the built site on 31 Oct: sign-in, encryption and the Urdu font all work.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' wss://{host}; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		try_files {path} /index.html
		file_server
	}
}

# www.pakchatapp.com goes to pakchatapp.com.
www.{$PAKCHAT_DOMAIN} {
	redir https://{$PAKCHAT_DOMAIN}{uri} permanent
}
