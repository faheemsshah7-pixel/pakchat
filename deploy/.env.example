# deploy/.env: PakChat's settings on the Oracle server. Copy this file to .env and fill it in.
# .env is never put in git (it holds secrets).

# The address people use, like pakchat.duckdns.org (its DNS must point at this server).
PAKCHAT_DOMAIN=
# The server's public and private addresses (Oracle's instance page), for the call relay.
PUBLIC_IP=
PRIVATE_IP=

# Long random secrets, each made with: openssl rand -hex 32  (setup.sh fills these in)
DB_PASSWORD=
SECRET_KEY_BASE=
TURN_SECRET=

# PakChat's Google client ids, comma separated (Google Cloud > APIs & Services > Credentials).
GOOGLE_CLIENT_IDS=

# Push alerts: put Firebase's service account key in deploy/secrets/firebase.json.
FCM_SERVICE_ACCOUNT=/secrets/firebase.json

# The biggest file to send, and the biggest backup, in MB.
FILE_MAX_MB=100
BACKUP_MAX_MB=2048

# GIFs: PakChat's free KLIPY key. Without it the app hides its GIF tab.
# KLIPY_KEY=

# Nightly backups copied off the server too (README.md, step 8): the Object Storage bucket's name.
# BACKUP_BUCKET=pakchat-backups
